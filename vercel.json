{
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/fonts/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
                { "key": "Access-Control-Allow-Origin", "value": "*" }
            ]
        },
        {
            "source": "/audio/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800" }
            ]
        },
        {
            "source": "/favicon.png",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800" }
            ]
        }
    ]
}
