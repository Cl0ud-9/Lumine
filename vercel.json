{
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "comment": "Vite content-hashes everything under /assets - the filename itself changes whenever the content does, so it's always safe to cache these forever.",
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "comment": "Not hash-named, so a moderate cache instead of immutable - still fine to revalidate if the file ever changes.",
            "source": "/audio/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800" }
            ]
        },
        {
            "source": "/favicon.png",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=604800" }
            ]
        }
    ]
}
